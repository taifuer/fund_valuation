{
  "name": "fund-estimate",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "backend:setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "backend": ".venv/bin/python -m backend.server",
    "backend:worker": ".venv/bin/python -m backend.worker",
    "backend:backfill": ".venv/bin/python -m backend.backfill",
    "backend:db": ".venv/bin/python -m backend.db_admin",
    "data:companies:audit": "vite-node --script scripts/audit-company-data.ts",
    "data:companies:check": "vite-node --script scripts/check-company-releases.ts",
    "data:companies:draft": "vite-node --script scripts/generate-sec-company-draft.ts",
    "data:companies:calendar": "vite-node --script scripts/sync-sec-report-calendar.ts",
    "dev": "vite",
    "test": "npm run test:backend && npm run test:unit && npm run test:frontend",
    "test:backend": ".venv/bin/python -m unittest discover -s backend/tests",
    "test:unit": "vitest run",
    "test:frontend": "node scripts/run-frontend-tests.mjs",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
