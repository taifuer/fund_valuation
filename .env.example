# Public HTTP port exposed by Docker Compose.
FUND_VALUATION_HTTP_HOST=0.0.0.0
FUND_VALUATION_HTTP_PORT=8080

# Generate a random value for production, for example: openssl rand -hex 32
FUND_VALUATION_DIAGNOSTICS_TOKEN=replace-with-a-random-token

# Set to 0 to hide fund management and reject non-default fund codes in the API.
FUND_VALUATION_ENABLE_FUND_MANAGEMENT=1

# Optional Baidu Analytics site ID (32 hexadecimal characters).
FUND_VALUATION_BAIDU_ANALYTICS_ID=

# Optional package mirrors for Docker builds.
FUND_VALUATION_NPM_REGISTRY=https://registry.npmjs.org
FUND_VALUATION_PIP_INDEX_URL=https://pypi.org/simple

# Retention for regenerable data.
FUND_VALUATION_SNAPSHOT_RETENTION_DAYS=7
FUND_VALUATION_RESPONSE_CACHE_RETENTION_DAYS=14
FUND_VALUATION_RAW_RETENTION_DAYS=7

# SQLite online backup schedule.
FUND_VALUATION_AUTO_BACKUP=1
FUND_VALUATION_BACKUP_INTERVAL_HOURS=24
FUND_VALUATION_BACKUP_RETENTION_DAYS=7
FUND_VALUATION_BACKUP_MAX_FILES=3

# Docker json-file log rotation.
FUND_VALUATION_LOG_MAX_SIZE=10m
FUND_VALUATION_LOG_MAX_FILES=3
